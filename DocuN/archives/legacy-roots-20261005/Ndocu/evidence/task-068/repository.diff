+                    WHERE activity_id = %s
+                      AND state IN ('reserved', 'dispatched')
+                      AND execution_generation < %s
+                    RETURNING operation_id""",
+                (error_code, activity_id, current_generation),
+            )
+            changed = list(await cursor.fetchall())
+            return len(changed)
 
