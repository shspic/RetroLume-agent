+        for path in sorted((BACKEND/"migrations").glob("00[1-6]_*.sql")): conn.execute(path.read_text(encoding="utf-8"))
+    # 生产固定入口：合法配置但未获活动模型授权，真实gateway/PG必须拒绝出站。
