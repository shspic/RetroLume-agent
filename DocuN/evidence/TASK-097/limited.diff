+    profile: Literal["learning.v1"]
+    action: Literal["first", "followup"]
+    activity_id: str
+    request_sha256: str = Field(pattern=r"^[0-9a-f]{64}$")
+    goal: str = Field(min_length=1, max_length=MAX_INPUT_CHARS)
