+"""learning.v1受信应用上下文与低信任模型输出的严格合同。"""
+from __future__ import annotations
+
+import hashlib
+import json
+from typing import Literal
+from uuid import UUID
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator, model_validator
