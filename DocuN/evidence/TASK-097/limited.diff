+
+class Segment(Strict):
+    text: str = Field(min_length=1, max_length=1024)
+    citations: list[str] = Field(min_length=1, max_length=4)
+
+
+class LearningOutput(Strict):
+    kind: Literal["answer", "clarification", "no_evidence", "conflict"]
