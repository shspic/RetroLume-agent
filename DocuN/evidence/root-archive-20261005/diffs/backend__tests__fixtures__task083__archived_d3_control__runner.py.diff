+def source_fingerprints(script):
+    # 分部复用只排除其他分部的函数；公共入口/导入/辅助函数及全部生产依赖仍参与 hash。
+    tree=ast.parse(script)
+    functions={"migration":{"migration_cases"},"ledger":{"ledger_cases","lock_barrier_case","observe_source_lock_wait"},
+               "windows":{"windows_case"}}
+    dependencies=sorted((ROOT/"backend/app").rglob("*.py"))+sorted((ROOT/"backend/migrations").glob("*.sql"))
+    dependency_hash=hashlib.sha256(b"".join(p.as_posix().encode()+p.read_bytes() for p in dependencies)).digest()
+    result={}
+    for part in SCENARIOS:
+        excluded=set.union(*(names for key,names in functions.items() if key!=part))
+        selected=ast.Module(body=[node for node in tree.body if getattr(node,"name",None) not in excluded],type_ignores=[])
+        result[part]=hashlib.sha256(dependency_hash+ast.dump(selected).encode()).hexdigest()
+    return result
+
