+                        r.write(root/('gap-ready-'+tag+'.json'),{'operation_id':p['operation_id'],'dispatch_released':True,'worker_pid':os.getpid(),'worker_thread':__import__('threading').get_ident(),'utc':r.utc()},private=True)
+                        deadline=time.monotonic()+5
