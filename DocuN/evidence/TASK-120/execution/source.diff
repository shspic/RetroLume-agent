+MAX_TOOL_ARGUMENT_BYTES = 2048
+_TOOL_ID_RE = re.compile(r"[A-Za-z0-9._:/-]{1,128}\Z")
+_TOOL_HEX64_RE = re.compile(r"[0-9a-f]{64}\Z")
