+        setNotice(approval?qApprovalText(approval):unclaimed?'已接受且尚未领取启动；可明确恢复原意图一次。':status==="failed"||status==="not_sent"?"已确认本次失败；可显式以新键重试。":"结果仍在途或未知；仅核对，不会重复启动。");
