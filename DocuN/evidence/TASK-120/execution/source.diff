+      } else {
+        setFeedback(null);
+      }
+    } catch (reason) {
+      if (!mounted.current || seq !== readSeq.current) return;
+      if (reason instanceof TeachingApiError && reason.status === 0) {
+        setReadError("读取未确认（连接中断）；只读核对，不自动重发");
