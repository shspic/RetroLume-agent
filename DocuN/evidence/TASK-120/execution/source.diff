+def parse_tool_arguments(text: str) -> Any:
+    """严格解析工具规范参数字符串；拒绝重复键与非有限常量。"""
+    return json.loads(
+        text,
+        object_pairs_hook=_unique_pairs,
+        parse_constant=lambda _: (_ for _ in ()).throw(ValueError("nonfinite")),
+    )
+
