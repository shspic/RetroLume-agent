+                except (KeyError, ValueError, TypeError):
+                    valid = False
+                if not valid:
+                    raise DataError("control_corrupt", 503)
+                if raw != canonical(event).encode('utf-8'):
+                    raise DataError('control_corrupt',503)
+                previous = digest(raw)
+                events.append(event)
