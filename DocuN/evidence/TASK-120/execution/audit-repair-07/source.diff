+        if not math.isfinite(seconds) or seconds <= 0:
+            raise DataError('operation_timeout',504)
+        self.hub,self.job_id,self.actor=hub,job_id,str(uuid4())
+        now=time.monotonic_ns()
+        self.deadline_ns=now+int(seconds*1e9)
