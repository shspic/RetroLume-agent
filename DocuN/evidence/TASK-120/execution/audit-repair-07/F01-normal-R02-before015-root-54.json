  "constraints": [
    {
      "conname": "data_control_check",
      "definition": "CHECK (((mode <> 'loading'::text) OR ((loader_session_user IS NOT NULL) AND (source_snapshot_id IS NOT NULL))))"
    },
    {
      "conname": "data_control_instance_id_key",
      "definition": "UNIQUE (instance_id)"
    },
    {
      "conname": "data_control_maintenance_key_sha256_check",
      "definition": "CHECK ((maintenance_key_sha256 ~ '^[0-9a-f]{64}$'::text))"
    },
    {
      "conname": "data_control_mode_check",
      "definition": "CHECK ((mode = ANY (ARRAY['normal'::text, 'loading'::text, 'frozen'::text, 'restored_readonly'::text])))"
    },
    {
      "conname": "data_control_pkey",
      "definition": "PRIMARY KEY (singleton)"
    },
    {
      "conname": "data_control_reference_epoch_check",
      "definition": "CHECK ((reference_epoch >= 0))"
    },
    {
      "conname": "data_control_schema_profile_check",
      "definition": "CHECK ((schema_profile = ANY (ARRAY['data_exit.v1.r01'::text, 'data_exit.v1.r02'::text])))"
    },
    {
      "conname": "data_control_singleton_check",
      "definition": "CHECK (singleton)"
    }
  ],
