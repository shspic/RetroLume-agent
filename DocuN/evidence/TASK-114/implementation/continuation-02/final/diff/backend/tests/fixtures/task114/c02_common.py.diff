+    try:docker_call(['start',target.cid]);budget.event('running_observed',inspect_target(target,IMAGE))
+    except BaseException:stop_source(budget,target);raise
+
+
+def stop_source(budget,target):
+    value=inspect_target(target,IMAGE)
+    if value['running']:docker_call(['stop','--time','10',target.cid],timeout=20)
+    value=inspect_target(target,IMAGE)
+    if value['running']:raise RuntimeError('source停止未知')
+    budget.end(target.cid,value)
+
+
