+class Evidence:
+    def __init__(self,label,credentials=None):
+        self.path=EVIDENCE/'batches'/label;self.path.mkdir(parents=True)
+        self.needles=[]
+        if credentials:
+            from psycopg.conninfo import conninfo_to_dict
+            for key,value in credentials.items():
+                if key.endswith('_dsn'):self.needles.extend((value,conninfo_to_dict(value).get('password','')))
+                elif key=='maintenance_key':self.needles.append(value)
+    def scrub(self,raw):
+        for value in sorted(self.needles,key=len,reverse=True):
+            if value:raw=raw.replace(value,'[private value removed]')
+        return raw
+    def save(self,name,value):
+        path=self.path/(name+'.json')
+        with path.open('x',encoding='utf-8') as f:f.write(self.scrub(json.dumps(plain(value),ensure_ascii=False,indent=2)))
+        print(json.dumps({'observation':name,'path':str(path)}),flush=True)
+    def fail(self,error):
+        self.save('failure',{'type':type(error).__name__,'code':getattr(error,'code',None),'sqlstate':getattr(error,'sqlstate',None)})
+        (self.path/'failure.txt').write_text(self.scrub(traceback.format_exc()),encoding='utf-8')
+
