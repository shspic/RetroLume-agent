+import {useDataContext} from './context';
 const categories=[['activities','活动与备份时点的账'],['learning','已保存学习输出'],['teaching','教学记录与修正'],['interview','面试记录与修正'],['memories','记忆版本与撤销'],['preview_history','预览历史与未知预留'],['versions','资料全部版本']];
