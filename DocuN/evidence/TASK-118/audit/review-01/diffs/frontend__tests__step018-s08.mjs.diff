+function installBarrier(){
+ const descriptor=Object.getOwnPropertyDescriptor(IDBTransaction.prototype,'oncomplete');
+ const nativePut=IDBObjectStore.prototype.put;
+ window.__s08Barrier={hit:false};window.__s08Arm=false;window.__s08Release=null;
+ IDBObjectStore.prototype.put=function(value,...rest){
+  if(window.__s08Arm&&typeof value?.draft_id==='string'&&value.draft_id.startsWith('draft-')){
+   this.transaction.__s08Draft=value;
+  }
+  return nativePut.call(this,value,...rest);
+ };
+ Object.defineProperty(IDBTransaction.prototype,'oncomplete',{configurable:true,enumerable:descriptor.enumerable,
+  get(){return descriptor.get.call(this);},set(callback){descriptor.set.call(this,typeof callback==='function'?function(event){
+   if(window.__s08Arm&&this.__s08Draft){window.__s08Arm=false;window.__s08Barrier={hit:true,draft:this.__s08Draft,committed:true};
+    window.__s08Release=()=>{window.__s08Release=null;callback.call(this,event);};
+   }else callback.call(this,event);
+  }:callback);}});
