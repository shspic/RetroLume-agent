{
  "model_identity": {
    "provider": "deepseek_chat_completions",
    "model": "deepseek-chat"
  },
  "activity_defaults": {
    "deadline_hours": 24,
    "max_requests": 80,
    "max_cost_microunits": 20000000,
    "reserve_cost_microunits": 250000,
    "max_request_bytes": 65536,
    "max_output_tokens": 4096,
    "max_running_seconds": 3600,
    "allowed_tools": [
      "finite_calculate"
    ],
    "max_tool_calls": 8
  },
  "service": {
    "base_url": "https://api.deepseek.com",
    "thinking": "disabled",
    "timeout_seconds": 10,
    "max_output_tokens_limit": 4096,
    "max_request_bytes": 65536,
    "max_response_bytes": 65536
  },
  "api_key_env": "RETROLUME_MODEL_API_KEY",
  "learning": {
    "profile": "learning.v2",
    "max_output_tokens": 256
  },
  "teaching": {
    "profile": "teaching.v3",
    "max_output_tokens": 2048,
    "enable_calculation": true
  },
  "interview": {
    "profile": "interview.v2",
    "max_output_tokens": 2048,
    "max_followups_per_round": 2
  },
  "html": {
    "profile": "html_explanation.v2",
    "max_output_tokens": 4096
  }
}
