+      if (command.action === "revoke") await clearMemoryDraftsForId(command.memory_id);
+    }
+    return receipt;
+  } catch (reason) {
+    await updateMemoryIntent(intent.key, reason instanceof api.MemoryApiError && reason.status > 0 ? "refused" : "unconfirmed");
+    throw reason;
+  }
