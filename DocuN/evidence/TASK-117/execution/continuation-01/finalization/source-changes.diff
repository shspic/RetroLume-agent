+def _state_after(revision: int, head: dict) -> str:
+    value = {
+        "schema": STATE_SCHEMA, "revision": revision,
+        "goal_version": head["goal_version"], "phase": head["phase"],
+        "goal_record_id": head["goal_record_id"], "path_record_id": head["path_record_id"],
