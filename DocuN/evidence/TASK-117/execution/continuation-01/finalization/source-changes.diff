+            raise ValueError("invalid_input")
+        if self.purpose in ("continuation", "retest") and (self.parent_exercise_record_id is None
+                                                           or self.parent_feedback_record_id is None):
+            raise ValueError("invalid_input")
+        _validate_instance_data(self.instance_data)
