+    def commit(self, kind, payload, *, validate=None):
+        with self.lock.acquire(True, timeout=1):
+            cached = self._validated_locked(writable=True)
+            events, state = cached[4], json.loads(cached[1])
+            if validate is not None:
+                validate(state)
