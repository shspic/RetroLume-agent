+    def _current_snapshot(self, job_id=None, *, writable=False):
+        with self.lock.acquire():
+            cached = self._validated_locked(writable=writable)
+            # 不把可变的日志payload或缓存对象交给调用者。
+            return json.loads(cached[1] if job_id is None else cached[2][job_id])
+
+    def state(self):
+        return self._current_snapshot()
+
+    def execution_job(self, job_id):
+        """同一完整字节校验，只复制当前操作，避免逐行解码无关计划。"""
+        return self._current_snapshot(job_id)
