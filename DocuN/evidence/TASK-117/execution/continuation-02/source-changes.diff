+                if status['state']=='stopped':break
+                if status['state']=='cleanup_unconfirmed':raise RuntimeError('preview_cleanup_unconfirmed')
+                time.sleep(.15)
+            else:raise RuntimeError('preview_stop_unconfirmed')
