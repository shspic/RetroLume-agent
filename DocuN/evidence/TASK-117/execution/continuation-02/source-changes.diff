+            proof=rc.metadata(cid)
+            intent=next((t for t in self.factory.hub.state()['targets'].values() if t['slot_id']==slot['id']),None)
+            if (not intent or proof['name']!=slot['name'] or proof['image']!=rc.PG_IMAGE
