+    def q_decide(self, kind, decide):
+        """Q-only CAS. Decision seq is selected under the actual journal lock (K1)."""
+        if kind not in ('q.bind','q.prepared','q.approved','q.revoked','q.claim','q.launch_claim',
+                        'q.admission_intent','q.admission_observed','q.closed'):
+            raise DataError('q_event_not_allowed')
