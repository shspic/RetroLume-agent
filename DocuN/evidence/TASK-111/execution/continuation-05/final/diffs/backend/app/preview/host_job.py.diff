+    """只查询零任务或准确已销毁；不存在绝不填ActiveProcesses=0。"""
+    if (not isinstance(premise,dict) or premise.get("name")!=name or premise.get("actual_query") is not True
+        or not premise.get("limit_flags",0)&0x2000 or premise["limit_flags"]&(0x800|0x1000)
+        or premise.get("handle_noninheritable") is not True or premise.get("kill_on_close") is not True
+        or premise.get("breakaway_allowed") is not False or not premise.get("owner")):
