{
  "schema": "retrolume.description_contract.v1",
  "description_schema": "interactive_description.v1",
  "required": ["schema", "title", "concept", "inputs", "calculations", "views", "actions", "calculation_notes", "limitations", "citations"],
  "optional": ["constraints"],
  "additional_properties": false,
  "bounds": {"utf8_bytes": 24576, "inputs": 8, "calculations": 32, "ast_nodes": 256, "ast_depth": 16, "views": 4, "figures": 2, "points": 128, "bars": 21, "update_steps": 50000, "actions": 4, "decimal_bytes": 24, "control_absolute": 1000000},
  "leaf_operations": ["const", "input", "result", "sample_x"],
  "operation_arity": {"add": 2, "sub": 2, "mul": 2, "div": 2, "neg": 1, "abs": 1, "min": 2, "max": 2, "pow_int": 2, "sqrt": 1, "sin": 1, "cos": 1, "binomial_pmf": 3},
  "input_kinds": ["number", "range", "integer"],
  "view_kinds": ["readout", "bar", "curve", "points_lines"],
  "bar_sources": ["values", "binomial_distribution"],
  "action_kinds": ["reset"],
  "constraint_kinds": ["le"],
  "canonical": "UTF8_without_BOM_sorted_ASCII_keys_compact_no_nonfinite_decimal_values_as_strings",
  "semantics": "Python description.py and Node/browser runtime.cjs implement the same closed fields and limits; executable strings, arbitrary markup/URL/DOM/tool paths are absent."
}
