+            elif isinstance(x,list):
+                for child in x:depth(child,n+1)
+        depth(value)
+        return value
+    except (ValueError,UnicodeError,RecursionError):
+        raise MemoryRefusal("invalid_input","请求内容不可核对",400) from None
