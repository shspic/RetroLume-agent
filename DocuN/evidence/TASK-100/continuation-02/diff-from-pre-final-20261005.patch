+            # 记录；records 在本事务内不发生第二次写（不可变触发器保护）。
+            goal_seq = next_seq()
+            # 旧目标在途命令 obsolete、清下游引用与 pending。
+            await self._teaching_obsolete_pending(connection, activity_id)
