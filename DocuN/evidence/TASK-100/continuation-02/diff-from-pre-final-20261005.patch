+        def next_seq() -> int:
+            nonlocal seq_base
+            seq_base += 1
+            if seq_base > MAX_RECORDS:
+                raise TeachingRefusal("history_limit", "教学记录数已达上限，请新建活动")
+            return seq_base
+
+        def bump_revision() -> int:
+            nonlocal revision
+            revision += 1
