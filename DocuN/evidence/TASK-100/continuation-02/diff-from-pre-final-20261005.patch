+def _seven_result(payload_text: str):
+    """解析 007 规范封套中的低信任 result；失败返回 None（局部抑制）。"""
+    if not payload_text:
+        return None
+    try:
+        return json.loads(payload_text)["value"]["result"]
+    except (ValueError, TypeError, KeyError):
+        return None
