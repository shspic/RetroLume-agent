-def _encode_cursor(fact: ActivityFactView) -> str:
-    raw = json.dumps({"t": fact.created_at.isoformat(), "i": fact.activity_id}).encode("utf-8")
-    return base64.urlsafe_b64encode(raw).decode("ascii")
