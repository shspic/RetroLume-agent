+        'correct_parts':[item],'errors':[dict(item,explanation=error_reason[kind],point_ids=['p2'] if kind=='program' else ['p3'] if kind=='concept' else ['p1','p2'])] if wrong else [],'evidence_gaps':[dict(item,explanation='仍缺完整换算、边界说明或逐步状态。')] if wrong else [],
