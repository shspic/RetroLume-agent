+def run_process(argv,deadline,stage,directory,*,env=None,cwd=BACKEND,stdin=None):
+    """stdout/stderr 直接保留完整原件；异常也关闭已创建的实际进程。"""
+    directory=Path(directory); directory.mkdir(parents=True,exist_ok=False)
