+_ANSWER_QUANTITY = re.compile(_ANSWER_NUMBER + r"\s*(m\s*/\s*min|m\s*/\s*s|米\s*/\s*秒|米每秒|min|分钟|秒|s|m|米)(?![A-Za-z0-9/])")
