+def _answer_quantity(text: str, unit: str | None):
+    """仅核一个明确的有限数值量；多值/开放语义/程序原文不猜结论。"""
+    unit = re.sub(r"\s+", "", unit or "")
+    candidates = [(Decimal(m[1]), re.sub(r"\s+", "", m[2])) for m in _ANSWER_QUANTITY.finditer(text)]
+    if unit in _ANSWER_UNITS:
+        family = _ANSWER_UNITS[unit][0]
+        same = [c for c in candidates if _ANSWER_UNITS[c[1]][0] == family]
+        if len(same) == 1:
+            return same[0]
+        if not same and len(candidates) == 1:
+            return candidates[0]
+        return None
+    if not unit:
+        match = re.fullmatch(r"\s*(?:约\s*)?(-?[0-9]+(?:\.[0-9]+)?)\s*", text)
+        if match:
+            return Decimal(match[1]), ""
+    return None
 
 
