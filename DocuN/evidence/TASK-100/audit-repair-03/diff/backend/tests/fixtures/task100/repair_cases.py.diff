+async def unclaimed_model(fixture, aid):
+    head=fixture.head(aid)
+    cmd=command(head,'evaluate',{'confirmed':True,'exercise_record_id':str(head['exercise_record_id']),
+        'answer_record_id':str(head['answer_record_id']),'correction_record_id':None,'retry_of':None})
+    service=TeachingService(fixture.ledger,fixture.materials,fixture.originals)
+    frozen,_=await service._freeze_model_context(aid,cmd,config())
+    receipt=await fixture.ledger.accept_teaching_command(aid,cmd,frozen)
+    assert receipt.status=='accepted'
+    return cmd,frozen
+
+
+async def unclaimed_tool(fixture, aid):
+    head=fixture.head(aid)
+    cmd=command(head,'calculate',{'confirmed':True,'exercise_record_id':str(head['exercise_record_id']),
+        'answer_record_id':str(head['answer_record_id']),'reference_point_id':'p1','retry_of':None})
+    service=TeachingService(fixture.ledger,fixture.materials,fixture.originals)
+    with patch.object(fixture.ledger,'claim_teaching_launch',AsyncMock(side_effect=RuntimeError('fixed_cut_after_accept_commit'))):
+        try: await service.submit_command(aid,cmd,config())
+        except RuntimeError as exc: assert str(exc)=='fixed_cut_after_accept_commit'
+        else: raise AssertionError('cut was not reached')
+    row=await fixture.ledger.read_teaching_command(aid,cmd.business_key)
+    assert row['command']['status']=='accepted' and row['command']['launch_claimed_at'] is None
+    return cmd,row['command']['context_sha256']
+
+
+async def ready_node(fixture, node, text, *, seed_exercise=True):
+    aid,source,eid,answer=await ready_answer(fixture)
+    if node!='n1':
+        await fixture.ledger.apply_teaching_local(aid,command(fixture.head(aid),'answer',{
+            'exercise_record_id':eid,'kind':'revision','text':'1m/s；2分钟=120秒，单位与数量级正确。','supersedes_answer_record_id':answer}))
+        await commit_feedback(fixture,aid)
+        head=fixture.head(aid)
+        retest=await seed_model(fixture,aid,'exercise',{'confirmed':True,'path_record_id':str(head['path_record_id']),
+            'node_id':'n1','purpose':'retest','parent_feedback_record_id':str(head['feedback_record_id']),'retry_of':None})
+        await fixture.ledger.apply_teaching_local(aid,command(fixture.head(aid),'answer',{
+            'exercise_record_id':retest,'kind':'initial','text':'1m/s；3分钟=180秒，先换算秒，数量级正确。','supersedes_answer_record_id':None}))
+        await commit_feedback(fixture,aid)
+        head=fixture.head(aid)
+        assert json.loads(head['projection'])['nodes']['n1']['status']=='evidence_sufficient',head
+        if node!='n2':
+            await fixture.ledger.apply_teaching_local(aid,command(head,'select_node',{'path_record_id':str(head['path_record_id']),
+                'node_id':node,'archive_current':True}))
+        head=fixture.head(aid)
+        if not seed_exercise: return aid,source,None,None
+        eid=await seed_model(fixture,aid,'exercise',{'confirmed':True,'path_record_id':str(head['path_record_id']),
+            'node_id':node,'purpose':'initial','parent_feedback_record_id':None,'retry_of':None})
+        receipt=await fixture.ledger.apply_teaching_local(aid,command(fixture.head(aid),'answer',{
+            'exercise_record_id':eid,'kind':'initial','text':text,'supersedes_answer_record_id':None}))
+    else:
+        receipt=await fixture.ledger.apply_teaching_local(aid,command(fixture.head(aid),'answer',{
+            'exercise_record_id':eid,'kind':'revision','text':text,'supersedes_answer_record_id':answer}))
+    return aid,source,eid,receipt.record_ids[0].record_id
