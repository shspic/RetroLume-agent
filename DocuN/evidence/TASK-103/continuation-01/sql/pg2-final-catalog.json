  "constraints": [
    [
      "activities",
      "activities_allowed_tools_check",
      "CHECK ((cardinality(allowed_tools) <= 32))",
      true
    ],
    [
      "activities",
      "activities_check",
      "CHECK (((requests_reserved >= 0) AND (requests_reserved <= max_requests)))",
      true
    ],
    [
      "activities",
      "activities_check1",
      "CHECK (((cost_reserved_microunits >= 0) AND (cost_reserved_microunits <= max_cost_microunits)))",
      true
    ],
    [
      "activities",
      "activities_check2",
      "CHECK (((reserve_cost_microunits > 0) AND (reserve_cost_microunits <= max_cost_microunits)))",
      true
    ],
    [
      "activities",
      "activities_check3",
      "CHECK ((((status = 'running'::text) AND (executor_id IS NOT NULL) AND (lease_expires_at IS NOT NULL)) OR (status <> 'running'::text)))",
      true
    ],
    [
      "activities",
      "activities_execution_generation_check",
      "CHECK ((execution_generation >= 0))",
      true
    ],
    [
      "activities",
      "activities_last_settled_generation_check",
      "CHECK (((last_settled_generation IS NULL) OR (last_settled_generation >= 0)))",
      true
    ],
    [
      "activities",
      "activities_last_settled_seconds_check",
      "CHECK (((last_settled_seconds IS NULL) OR (last_settled_seconds >= 0)))",
      true
    ],
    [
      "activities",
      "activities_max_cost_microunits_check",
      "CHECK ((max_cost_microunits > 0))",
      true
    ],
    [
      "activities",
      "activities_max_output_tokens_check",
      "CHECK ((max_output_tokens > 0))",
      true
    ],
    [
      "activities",
      "activities_max_request_bytes_check",
      "CHECK ((max_request_bytes > 0))",
      true
    ],
    [
      "activities",
      "activities_max_requests_check",
      "CHECK ((max_requests > 0))",
      true
    ],
    [
      "activities",
      "activities_max_running_seconds_check",
      "CHECK (((max_running_seconds > 0) AND (max_running_seconds <= 2147483647)))",
      true
    ],
    [
      "activities",
      "activities_pkey",
      "PRIMARY KEY (id)",
      true
    ],
    [
      "activities",
      "activities_running_owner_session_id_check",
      "CHECK (((running_owner_session_id >= 0) AND (running_owner_session_id <= '4294967295'::bigint)))",
      true
    ],
    [
      "activities",
      "activities_running_reserved_seconds_check",
      "CHECK ((running_reserved_seconds >= 0))",
      true
    ],
    [
      "activities",
      "activities_running_settled_seconds_check",
      "CHECK ((running_settled_seconds >= 0))",
      true
    ],
    [
      "activities",
      "activities_scope_revision_check",
      "CHECK ((scope_revision > 0))",
      true
    ],
    [
      "activities",
      "activities_status_check",
      "CHECK ((status = ANY (ARRAY['pending'::text, 'running'::text, 'cancelled'::text])))",
      true
    ],
    [
      "activities",
      "activities_time_budget_balance",
      "CHECK ((running_reserved_seconds <= (max_running_seconds - running_settled_seconds)))",
      true
    ],
    [
      "activities",
      "activities_time_budget_last_settled_pair",
      "CHECK (((last_settled_generation IS NULL) = (last_settled_seconds IS NULL)))",
      true
    ],
    [
      "activities",
      "activities_time_budget_running_shape",
      "CHECK (((status = 'running'::text) = (running_reserved_seconds > 0)))",
      true
    ],
    [
      "activities",
      "activities_tool_budget_balance",
      "CHECK ((((max_tool_calls IS NULL) AND (tools_reserved = 0)) OR ((max_tool_calls IS NOT NULL) AND ((tools_reserved >= 0) AND (tools_reserved <= max_tool_calls)))))",
      true
    ],
    [
      "activities",
      "activities_tool_budget_limit",
      "CHECK (((max_tool_calls IS NULL) OR (max_tool_calls >= 0)))",
      true
    ],
    [
      "activities",
      "activities_tool_budget_reserved",
      "CHECK ((tools_reserved >= 0))",
      true
    ],
