+def _interview_check(data, defaults, cont, service):
+    if data.get('interview') is None:
+        return LayerState(False,'interview_not_configured'),None,None
+    try:
+        value=_InterviewInput.model_validate(data['interview'])
+    except ValidationError:
+        return LayerState(False,'interview_config_invalid'),None,None
+    if not cont.available or service is None:
+        return LayerState(False,'interview_model_unavailable'),None,None
+    if value.max_output_tokens>min(defaults.max_output_tokens,service.max_output_tokens_limit):
+        return LayerState(False,'interview_config_invalid'),None,None
+    return LayerState(True),value.max_output_tokens,value.max_followups_per_round
+
