+// 不用全期历史峰值差分（续作02 卡面要求）。
+function windowPeak(requests) {
+  const events = [];
+  for (const item of requests) {
+    if (typeof item.t_start !== "number" || typeof item.t_end !== "number") continue;
+    events.push([item.t_start, 1], [item.t_end, -1]);
+  }
+  events.sort((a, b) => a[0] - b[0] || a[1] - b[1]); // 同时刻先处理结束，避免虚增
+  let current = 0;
+  let peak = 0;
+  for (const [, delta] of events) {
+    current += delta;
+    peak = Math.max(peak, current);
+  }
+  return peak;
+}
